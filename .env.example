# Bolt Database (Supabase) project URL and anon key (required).
# Bolt creates these in its own .env; copy them here for local work.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL used for canonical / Open Graph / JSON-LD tags
VITE_SITE_URL=https://www.urfellowship.com

# Footer social links (a link is hidden when its variable is empty)
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=

# The YouTube Data API key is NOT listed here on purpose. It is a server secret
# (the Supabase edge function secret YOUTUBE_API_KEY). Anything named VITE_ is
# compiled into the public page code, where anyone can read it.
